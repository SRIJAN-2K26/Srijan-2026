---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import data from '../data/event.json';
import venue from '../assets/venue.jpg';
import poster from '../assets/poster.jpg';
import Story from '../components/Story.astro';

const { event: ev, register, nav, about, tracks, schedule, prizes, how, sponsors, faq, contact } = data;
const tagline = ev.tagline;
---
<Base>
  <a class="skip" href="#about">Skip to details</a>
  <div class="progress" aria-hidden="true"></div>

  <header class="top">
    <div class="wrap">
      <a class="brand" href="#top" aria-label={`${ev.name} ${ev.year} home`}>{ev.name} <span>{ev.year}</span></a>
      <nav class="nav" aria-label="Primary">
        {nav.map((n) => <a href={n.href} data-f={n.frame}>{n.label}</a>)}
      </nav>
      <details class="menu">
        <summary aria-expanded="false"><span class="bars" aria-hidden="true"></span>Menu</summary>
        <ul aria-label="Sections">
          {nav.map((n) => <li><a href={n.href} data-f={n.frame}>{n.label}</a></li>)}
        </ul>
      </details>
      <a class="btn btn-primary" href={register.href} target="_blank" rel="noopener noreferrer">{register.label}<span class="sr"> (opens in a new tab)</span></a>
    </div>
  </header>

  <div class="dock" id="dock"><div class="dock-in">
    <a class="btn btn-primary" href={register.href} target="_blank" rel="noopener noreferrer">
      {register.label}<span class="sr"> (opens in a new tab)</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div></div>

  <main id="main">
    <Story />

    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {[0, 1].map(() => (
          <div class="ticker-set">
            {[0, 1, 2].map(() => tagline.map((t, i) => <span class={i === 2 ? 'o' : ''}>{t} •</span>))}
          </div>
        ))}
      </div>
    </div>

    <!-- ABOUT -->
    <section id="about" aria-labelledby="about-h">
      <div class="wrap">
        <div class="about-grid">
          <div>
            <p class="eyebrow" data-reveal><b>01</b> About</p>
            <h2 id="about-h" class="display h2" data-reveal>{about.heading}</h2>
            <div data-stagger style="margin-top:1.5rem">
              {about.body.map((p, i) => <p class="lead" style={`--i:${i}`}>{p}</p>)}
            </div>
            <div class="plain-doms" id="domains" data-reveal><h3>Six domains</h3><ul class="chips">{tracks.list.map((t) => <li>{t}</li>)}</ul><p>{tracks.problemStatements.title}.</p></div>
          </div>
          <figure class="poster" data-reveal>
            <Picture src={poster} formats={['avif', 'webp']} fallbackFormat="webp" widths={[360, 520, 780]} sizes="(min-width: 56rem) 26rem, 90vw" width={520} height={780}
              alt="SRIJAN 2K26 inter-college hackathon poster: 13–14 Oct 2026, SRMCEM Campus Lucknow, hybrid mode" loading="lazy" />
            <figcaption>Official poster</figcaption>
          </figure>
        </div>

        <figure class="venue" data-reveal>
          <Picture src={venue} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 1024]} sizes="(min-width: 76rem) 70rem, 92vw" width={1024} height={380}
            alt="SRMCEM campus building with the golden Ashoka lion capital statue in front" loading="lazy" />
          <figcaption>{about.venueCaption} · {ev.venueFull}</figcaption>
        </figure>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how" class="alt" aria-labelledby="how-h">
      <div class="wrap">
        <p class="eyebrow" data-reveal><b>02</b> How it works</p>
        <h2 id="how-h" class="display h2" data-reveal>{how.heading}</h2>
        <ol class="stepper" data-stagger aria-label={how.aria}>
          {how.steps.map((s, k) => (
            <li class="stp" style={`--i:${k}`}>
              <span class="num" aria-hidden="true">{k + 1}</span>
              <div class="body">
                <h3>{s.title}</h3>
                <p>{s.reward ? `${prizes.total}. ${prizes.note}.` : s.text}</p>
                {s.tag && <span class="pill">{s.tag}</span>}
              </div>
            </li>
          ))}
        </ol>
        <div class="cta" data-reveal>
          <p class="display yourmove">{how.cta}</p>
          <a class="btn btn-primary btn-lg" href={register.href} target="_blank" rel="noopener noreferrer" data-register>{register.label}<span class="sr"> (opens in a new tab)</span></a>
        </div>
      </div>
    </section>

    <!-- SCHEDULE -->
    <section id="schedule" aria-labelledby="sch-h">
      <div class="wrap">
        <p class="eyebrow" data-reveal><b>03</b> Schedule</p>
        <h2 id="sch-h" class="display h2" data-reveal>{schedule.heading}</h2>
        <div class="days-grid" data-stagger>
          {schedule.days.map((d, i) => (
            <details class="day" open style={`--i:${i}`}>
              <summary>
                <span>
                  <span class="d">{d.day}</span><br />
                  <span class="date">{d.date}</span><br />
                  <span class="mode">{d.mode}</span>
                </span>
                <span class="chev" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
              </summary>
              <ol>{d.items.map((it) => <li>{it}</li>)}</ol>
            </details>
          ))}
        </div>
        <p class="foot-note" data-reveal>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          {schedule.footnote}
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="alt" aria-labelledby="faq-h">
      <div class="wrap">
        <p class="eyebrow" data-reveal><b>04</b> FAQ</p>
        <h2 id="faq-h" class="display h2" data-reveal>{faq.heading}</h2>
        <div class="faq" data-stagger>
          {faq.items.map((f, i) => (
            <details style={`--i:${i}`}>
              <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
              <p class="a">{f.a}</p>
            </details>
          ))}
        </div>
        <p class="faq-more" data-reveal>{faq.contactPointer.text} <a href={faq.contactPointer.href}>{faq.contactPointer.linkLabel}</a></p>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="contact" aria-labelledby="ct-h">
      <div class="wrap">
        <p class="eyebrow" data-reveal><b>05</b> Join in</p>
        <h2 id="ct-h" class="display" data-reveal>{contact.heading}</h2>
        <p class="lead" data-reveal>{contact.text}</p>
        <div class="cta" data-reveal>
          <a class="btn btn-primary btn-lg" href={register.href} target="_blank" rel="noopener noreferrer">{register.label}<span class="sr"> (opens in a new tab)</span></a>
          <a class="btn btn-ghost btn-lg" href={sponsors.partner.href} target="_blank" rel="noopener noreferrer">{sponsors.partner.label}</a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <div class="ask" id="contact-us" data-reveal>
        <h2 class="display">{contact.questions.heading}</h2>
        <ul class="people" data-stagger>
          {contact.questions.people.map((c, i) => (
            <li style={`--i:${i}`}>
              <a class="person" href={`mailto:${c.email}`}>
                <span class="who"><strong>{c.name}</strong><span>{c.role}</span></span>
                <span class="mail">{c.email}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="big">{ev.name} <span>{ev.year}</span></p>
        <p style="margin-top:.5rem">{ev.type} · {ev.datesLong} · {ev.mode}</p>
        <p style="margin-top:.5rem"><strong>{ev.organizers}</strong> in collaboration with <strong>{ev.collaborator}</strong></p>
        <p style="margin-top:.5rem">{ev.venueFull}</p>
        <p style="margin-top:.5rem">{ev.instituteLine}</p>
      </div>
      <ul aria-label="Footer links">
        <li><a href={sponsors.partner.href} target="_blank" rel="noopener noreferrer">{sponsors.partner.label}</a></li>
        <li><a href="#top">Back to top</a></li>
      </ul>
    </div>
  </footer>
</Base>
