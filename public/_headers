# Netlify / Cloudflare Pages. Vercel uses ../vercel.json (same policy; keep in sync).
# Cache-Control is set on non-overlapping paths on purpose: these hosts MERGE duplicate headers.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo=' 'sha256-dMCsJ1MHw9UR6O0+izv/LxZVkL6NOkkMqYaTZ1xbrpk='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Hashed build output (Astro fingerprints file names): cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML: short cache + background revalidation so edits propagate in minutes.
/
  Cache-Control: public, max-age=300, stale-while-revalidate=600

/index.html
  Cache-Control: public, max-age=300, stale-while-revalidate=600

# Un-hashed static files.
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
